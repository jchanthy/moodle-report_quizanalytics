</div>

<script>
(function() {
    var quizTableState = {
        currentPage: 1,
        pageSize: 10,
        filteredIndices: []
    };

    function updateFilteredIndices() {
        var searchInput = document.getElementById('student-search-input');
        var statusFilter = document.getElementById('student-status-filter');
        var rows = document.querySelectorAll('.student-attempt-row');

        if (!rows || rows.length === 0) {
            quizTableState.filteredIndices = [];
            return;
        }

        var query = searchInput ? searchInput.value.toLowerCase().trim() : '';
        var status = statusFilter ? statusFilter.value : 'all';
        var indices = [];

        rows.forEach(function(row, idx) {
            var name = (row.getAttribute('data-name') || '').toLowerCase();
            var email = (row.getAttribute('data-email') || '').toLowerCase();
            var idnumber = (row.getAttribute('data-idnumber') || '').toLowerCase();
            var rowStatus = row.getAttribute('data-status') || '';

            var matchesQuery = !query ||
                (name.indexOf(query) !== -1) ||
                (email.indexOf(query) !== -1) ||
                (idnumber.indexOf(query) !== -1);

            var matchesStatus = (status === 'all') || (rowStatus === status);

            if (matchesQuery && matchesStatus) {
                indices.push(idx);
            }
        });

        quizTableState.filteredIndices = indices;
    }

    function renderPagination() {
        var rows = document.querySelectorAll('.student-attempt-row');
        var noMatchRow = document.getElementById('no-matching-row');
        var fromElem = document.getElementById('pag-from');
        var toElem = document.getElementById('pag-to');
        var totalElem = document.getElementById('pag-total');
        var badgeElem = document.getElementById('records-counter-badge');
        var pagContainer = document.getElementById('student-pagination-list');

        if (!rows || rows.length === 0) return;

        var totalFiltered = quizTableState.filteredIndices.length;
        var isAll = (quizTableState.pageSize === 'all');
        var pSize = isAll ? totalFiltered : parseInt(quizTableState.pageSize, 10);
        if (pSize < 1) pSize = 10;

        var totalPages = isAll ? 1 : Math.max(1, Math.ceil(totalFiltered / pSize));
        if (quizTableState.currentPage > totalPages) quizTableState.currentPage = totalPages;
        if (quizTableState.currentPage < 1) quizTableState.currentPage = 1;

        var startIndex = isAll ? 0 : (quizTableState.currentPage - 1) * pSize;
        var endIndex = isAll ? totalFiltered : Math.min(startIndex + pSize, totalFiltered);

        // Hide all rows first
        rows.forEach(function(r) { r.style.display = 'none'; });

        // Show only current page slice
        for (var i = startIndex; i < endIndex; i++) {
            var rowIdx = quizTableState.filteredIndices[i];
            if (rows[rowIdx]) {
                rows[rowIdx].style.display = '';
            }
        }

        // Update counter badges and info
        if (fromElem) fromElem.textContent = (totalFiltered === 0) ? '0' : (startIndex + 1);
        if (toElem) toElem.textContent = endIndex;
        if (totalElem) totalElem.textContent = totalFiltered;
        if (badgeElem) badgeElem.innerHTML = 'Showing <strong>' + totalFiltered + '</strong> records';
        if (noMatchRow) noMatchRow.style.display = (totalFiltered === 0) ? '' : 'none';

        // Render pagination buttons
        if (!pagContainer) return;
        pagContainer.innerHTML = '';

        if (totalPages <= 1) return;

        function addPageItem(text, pageNum, isActive, isDisabled) {
            var li = document.createElement('li');
            li.className = 'page-item' + (isActive ? ' active' : '') + (isDisabled ? ' disabled' : '');
            var a = document.createElement('a');
            a.className = 'page-link';
            a.href = '#!';
            a.innerHTML = text;
            if (!isDisabled && !isActive) {
                a.onclick = function(e) {
                    e.preventDefault();
                    quizTableState.currentPage = pageNum;
                    renderPagination();
                };
            }
            li.appendChild(a);
            pagContainer.appendChild(li);
        }

        // Previous
        addPageItem('&laquo;', quizTableState.currentPage - 1, false, quizTableState.currentPage === 1);

        // Page numbers
        var maxVisible = 5;
        var startP = Math.max(1, quizTableState.currentPage - Math.floor(maxVisible / 2));
        var endP = Math.min(totalPages, startP + maxVisible - 1);
        if (endP - startP + 1 < maxVisible) {
            startP = Math.max(1, endP - maxVisible + 1);
        }

        if (startP > 1) {
            addPageItem('1', 1, false, false);
            if (startP > 2) {
                var ell = document.createElement('li');
                ell.className = 'page-item disabled';
                ell.innerHTML = '<span class="page-link">&hellip;</span>';
                pagContainer.appendChild(ell);
            }
        }

        for (var p = startP; p <= endP; p++) {
            addPageItem(p.toString(), p, p === quizTableState.currentPage, false);
        }

        if (endP < totalPages) {
            if (endP < totalPages - 1) {
                var ell2 = document.createElement('li');
                ell2.className = 'page-item disabled';
                ell2.innerHTML = '<span class="page-link">&hellip;</span>';
                pagContainer.appendChild(ell2);
            }
            addPageItem(totalPages.toString(), totalPages, false, false);
        }

        // Next
        addPageItem('&raquo;', quizTableState.currentPage + 1, false, quizTableState.currentPage === totalPages);
    }

    window.filterQuizStudents = function() {
        updateFilteredIndices();
        quizTableState.currentPage = 1;
        renderPagination();
    };

    window.changeQuizPageSize = function(size) {
        quizTableState.pageSize = size;
        quizTableState.currentPage = 1;
        renderPagination();
    };

    window.handleQuizExportDownload = function() {
        try {
            var selectedFields = [];
            document.querySelectorAll('.export-field:checked').forEach(function(cb) {
                selectedFields.push(cb.value);
            });
            localStorage.setItem('report_quizanalytics_export_fields', JSON.stringify(selectedFields));

            var checkedFormat = document.querySelector('.export-format-radio:checked');
            if (checkedFormat) {
                localStorage.setItem('report_quizanalytics_export_format', checkedFormat.value);
            }
        } catch(e) {}

        setTimeout(function() {
            var modalEl = document.getElementById('exportModal');
            if (modalEl) {
                if (typeof $ !== 'undefined' && $.fn && $.fn.modal) {
                    $('#exportModal').modal('hide');
                }
                if (typeof window.bootstrap !== 'undefined' && window.bootstrap.Modal) {
                    var bs = window.bootstrap.Modal.getInstance(modalEl);
                    if (bs) bs.hide();
                }
                var dismiss = modalEl.querySelector('[data-bs-dismiss="modal"], [data-dismiss="modal"], .btn-close');
                if (dismiss) dismiss.click();
            }
            setTimeout(function() {
                var bds = document.querySelectorAll('.modal-backdrop');
                bds.forEach(function(b) { b.remove(); });
                document.body.classList.remove('modal-open');
                document.body.style.removeProperty('padding-right');
                document.body.style.removeProperty('overflow');
            }, 200);
        }, 150);
    };

    // Auto-init on DOM ready
    function initTable() {
        updateFilteredIndices();
        renderPagination();

        try {
            var savedFields = localStorage.getItem('report_quizanalytics_export_fields');
            if (savedFields) {
                var fieldList = JSON.parse(savedFields);
                if (Array.isArray(fieldList) && fieldList.length > 0) {
                    document.querySelectorAll('.export-field').forEach(function(cb) {
                        cb.checked = (fieldList.indexOf(cb.value) !== -1);
                    });
                }
            }
            var savedFormat = localStorage.getItem('report_quizanalytics_export_format');
            if (savedFormat) {
                var formatRadio = document.querySelector('.export-format-radio[value="' + savedFormat + '"]');
                if (formatRadio) formatRadio.checked = true;
            }
        } catch(e) {}
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initTable);
    } else {
        initTable();
    }
})();
</script>

{{#js}}
require(['report_quizanalytics/charts'], function(charts) {
    charts.init();
});
{{/js}}



